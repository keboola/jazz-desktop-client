{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jasnost.dev/archive/schema/archive-artifact.schema.json",
  "title": "JazzArchiveArtifact",
  "description": "Local content-addressed captured, imported, or derived material. Remote file identifiers belong only to delivery state.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "artifactId", "captureId", "origin", "kind", "content", "sourceRefs", "actorRefs", "labelRefs", "observationRefs", "provenance", "quality", "privacy"],
  "properties": {
    "schemaVersion": {"const": 1},
    "artifactId": {"$ref": "https://jasnost.dev/archive/schema/archive-common.schema.json#/$defs/artifactId"},
    "captureId": {"$ref": "https://jasnost.dev/archive/schema/archive-common.schema.json#/$defs/captureId"},
    "origin": {"enum": ["captured", "imported", "derived"]},
    "kind": {"type": "string", "minLength": 1, "pattern": "^[a-z][a-z0-9._-]*$"},
    "contentSchema": {"type": "string", "format": "uri"},
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "mediaType", "byteLength", "sha256"],
      "properties": {
        "path": {"$ref": "https://jasnost.dev/archive/schema/archive-common.schema.json#/$defs/relativePath"},
        "mediaType": {"type": "string", "minLength": 1, "pattern": "^[^/\\s]+/[^\\s]+$"},
        "byteLength": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "https://jasnost.dev/archive/schema/archive-common.schema.json#/$defs/sha256"}
      }
    },
    "sourceRefs": {
      "type": "array",
      "items": {"$ref": "https://jasnost.dev/archive/schema/archive-common.schema.json#/$defs/sourceRef"}
    },
    "actorRefs": {
      "type": "array",
      "items": {"$ref": "https://jasnost.dev/archive/schema/archive-common.schema.json#/$defs/actorRef"}
    },
    "labelRefs": {
      "type": "array",
      "items": {"$ref": "https://jasnost.dev/archive/schema/archive-common.schema.json#/$defs/labelId"},
      "uniqueItems": true
    },
    "observationRefs": {
      "type": "array",
      "items": {"$ref": "https://jasnost.dev/archive/schema/archive-common.schema.json#/$defs/observationId"},
      "uniqueItems": true
    },
    "captureInterval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startedAt"],
      "properties": {
        "startedAt": {"type": "string", "format": "date-time"},
        "endedAt": {"type": "string", "format": "date-time"}
      }
    },
    "derivation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["producer", "computedAt", "inputRefs"],
      "properties": {
        "producer": {"$ref": "https://jasnost.dev/archive/schema/archive-common.schema.json#/$defs/producer"},
        "computedAt": {"type": "string", "format": "date-time"},
        "inputRefs": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "https://jasnost.dev/archive/schema/archive-common.schema.json#/$defs/genericRef"}
        },
        "parametersDigest": {"$ref": "https://jasnost.dev/archive/schema/archive-common.schema.json#/$defs/sha256"}
      }
    },
    "provenance": {"$ref": "https://jasnost.dev/archive/schema/archive-common.schema.json#/$defs/provenance"},
    "quality": {"$ref": "https://jasnost.dev/archive/schema/archive-common.schema.json#/$defs/quality"},
    "privacy": {"$ref": "https://jasnost.dev/archive/schema/archive-common.schema.json#/$defs/privacy"},
    "extensions": {"type": "object", "additionalProperties": true}
  },
  "allOf": [
    {
      "if": {"properties": {"origin": {"const": "derived"}}, "required": ["origin"]},
      "then": {
        "required": ["derivation"],
        "properties": {
          "provenance": {
            "properties": {"factClass": {"const": "derived"}}
          }
        }
      },
      "else": {"not": {"required": ["derivation"]}}
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jasnost.dev/schema/guided-replay.schema.json",
  "title": "GuidedReplayArtifact",
  "description": "Fail-closed, content-addressed decisions, single-consumer execution claims, start receipts, reconciliation records and execution receipts for one-step-at-a-time replay of an exact approved RunbookVersion.",
  "oneOf": [
    {"$ref": "#/$defs/decision"},
    {"$ref": "#/$defs/executionClaim"},
    {"$ref": "#/$defs/executionStartReceipt"},
    {"$ref": "#/$defs/executionReconciliation"},
    {"$ref": "#/$defs/executionReceipt"}
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["companyId", "areaId", "processId"],
      "properties": {
        "companyId": {"type": "string", "minLength": 1},
        "areaId": {"type": "string", "minLength": 1},
        "processId": {"type": "string", "minLength": 1}
      }
    },
    "evidence": {
      "type": "array",
      "description": "Grounding references, structurally identical to L4, BDM, ontology, Process Memory, Process Finding and RunbookVersion.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "ref"],
        "properties": {
          "kind": {"type": "string", "enum": ["event", "screenshot", "transcript", "observation", "artifact", "transcript_span", "assertion", "coach_interaction"]},
          "ref": {"type": "string"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    },
    "runbookRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runbookId",
        "runbookVersionId",
        "contentDigest",
        "version",
        "scope"
      ],
      "properties": {
        "runbookId": {"type": "string", "pattern": "^rb_[a-f0-9]{32}$"},
        "runbookVersionId": {"type": "string", "pattern": "^rbv_[a-f0-9]{32}$"},
        "contentDigest": {"$ref": "#/$defs/digest"},
        "version": {"type": "integer", "minimum": 1},
        "scope": {"$ref": "#/$defs/scope"}
      }
    },
    "providedCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "locatorResolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stepId",
        "locatorId",
        "kind",
        "matchCount",
        "applicationId",
        "resolvedAt",
        "evidence"
      ],
      "properties": {
        "stepId": {"type": "string", "pattern": "^rbs_[a-f0-9]{32}$"},
        "locatorId": {"type": "string", "pattern": "^rbl_[a-f0-9]{32}$"},
        "kind": {
          "enum": ["accessibility", "dom", "url", "businessObject", "visual", "coordinate"]
        },
        "matchCount": {"type": "integer", "minimum": 0},
        "applicationId": {"type": "string", "minLength": 1},
        "resolvedAt": {"type": "string", "format": "date-time"},
        "evidence": {"$ref": "#/$defs/evidence"}
      }
    },
    "applicationObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applicationId",
        "observedVersion",
        "matchedVersionConstraint",
        "compatibility",
        "resolver",
        "observedAt",
        "evidence"
      ],
      "properties": {
        "applicationId": {"type": "string", "minLength": 1},
        "observedVersion": {"type": "string", "minLength": 1},
        "environment": {"type": "string", "minLength": 1},
        "matchedVersionConstraint": {"type": "string", "minLength": 1},
        "compatibility": {"enum": ["compatible", "incompatible", "unknown"]},
        "resolver": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "version"],
          "properties": {
            "id": {"type": "string", "minLength": 1},
            "version": {"type": "string", "minLength": 1}
          }
        },
        "observedAt": {"type": "string", "format": "date-time"},
        "evidence": {"$ref": "#/$defs/evidence"}
      }
    },
    "anchorFreshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "checkedAt"],
      "properties": {
        "status": {"enum": ["fresh", "stale", "unknown"]},
        "checkedAt": {"type": "string", "format": "date-time"},
        "expiresAt": {"type": "string", "format": "date-time"}
      }
    },
    "businessObjectInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "scope",
        "systemNamespace",
        "connectionId",
        "objectType",
        "externalId",
        "anchorAssertionRef",
        "anchorAssertionDigest",
        "outcome",
        "lifecycle",
        "freshness",
        "resolvedAt",
        "evidence"
      ],
      "properties": {
        "role": {"type": "string", "minLength": 1},
        "scope": {"$ref": "#/$defs/scope"},
        "systemNamespace": {"type": "string", "minLength": 1},
        "connectionId": {"type": "string", "minLength": 1},
        "objectType": {"type": "string", "minLength": 1},
        "externalId": {"type": "string", "minLength": 1},
        "anchorAssertionRef": {"type": "string", "pattern": "^boa-[a-f0-9]{64}$"},
        "anchorAssertionDigest": {"$ref": "#/$defs/digest"},
        "outcome": {
          "enum": [
            "verified",
            "missing",
            "stale",
            "ambiguous",
            "deleted",
            "permission_denied",
            "not_found"
          ]
        },
        "lifecycle": {"enum": ["proposed", "verified", "disputed", "superseded"]},
        "freshness": {"$ref": "#/$defs/anchorFreshness"},
        "resolvedAt": {"type": "string", "format": "date-time"},
        "evidence": {"$ref": "#/$defs/evidence"}
      }
    },
    "trustedAnchorObject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["connectionId", "systemNamespace", "objectType", "externalId"],
      "properties": {
        "connectionId": {"type": "string", "minLength": 1},
        "systemNamespace": {"type": "string", "minLength": 1},
        "objectType": {"type": "string", "minLength": 1},
        "externalId": {"type": "string", "minLength": 1}
      }
    },
    "trustedAnchorPin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assertionId",
        "contentDigest",
        "scope",
        "outcome",
        "lifecycle",
        "retrievedAt",
        "object",
        "freshness"
      ],
      "properties": {
        "assertionId": {"type": "string", "pattern": "^boa-[a-f0-9]{64}$"},
        "contentDigest": {"$ref": "#/$defs/digest"},
        "scope": {"$ref": "#/$defs/scope"},
        "outcome": {"enum": ["verified", "stale"]},
        "lifecycle": {"enum": ["verified", "superseded"]},
        "retrievedAt": {"type": "string", "format": "date-time"},
        "object": {"$ref": "#/$defs/trustedAnchorObject"},
        "freshness": {"$ref": "#/$defs/anchorFreshness"}
      }
    },
    "validationPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxAgeSeconds"],
      "properties": {
        "maxAgeSeconds": {"type": "integer", "minimum": 1}
      }
    },
    "resolverIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "trustedCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "evidence"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "evidence": {"$ref": "#/$defs/evidence", "minItems": 1}
      }
    },
    "trustedRuntimeContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resolver",
        "resolvedAt",
        "requestContextDigest",
        "capabilities",
        "preconditions",
        "applicationObservations",
        "evidence"
      ],
      "properties": {
        "resolver": {"$ref": "#/$defs/resolverIdentity"},
        "resolvedAt": {"type": "string", "format": "date-time"},
        "requestContextDigest": {"$ref": "#/$defs/digest"},
        "capabilities": {
          "type": "array",
          "items": {"$ref": "#/$defs/trustedCapability"},
          "uniqueItems": true
        },
        "preconditions": {
          "type": "array",
          "items": {"$ref": "#/$defs/preconditionClaim"}
        },
        "locatorResolution": {"$ref": "#/$defs/locatorResolution"},
        "applicationObservations": {
          "type": "array",
          "items": {"$ref": "#/$defs/applicationObservation"}
        },
        "evidence": {"$ref": "#/$defs/evidence", "minItems": 1}
      }
    },
    "approvalPolicySnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policyId",
        "revision",
        "policyDigest",
        "policySource",
        "approverRole",
        "resolvedAt",
        "validFrom",
        "validUntil"
      ],
      "properties": {
        "policyId": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "policyDigest": {"$ref": "#/$defs/digest"},
        "policySource": {"type": "string", "minLength": 1},
        "approverRole": {"type": "string", "minLength": 1},
        "resolvedAt": {"type": "string", "format": "date-time"},
        "validFrom": {"type": "string", "format": "date-time"},
        "validUntil": {"type": "string", "format": "date-time"}
      }
    },
    "approvalPolicyState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approvalId",
        "policyId",
        "revision",
        "policyDigest",
        "approverRole",
        "resolvedAt",
        "status"
      ],
      "properties": {
        "approvalId": {"type": "string", "pattern": "^gra_[a-f0-9]{32}$"},
        "policyId": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "policyDigest": {"$ref": "#/$defs/digest"},
        "approverRole": {"type": "string", "minLength": 1},
        "resolvedAt": {"type": "string", "format": "date-time"},
        "status": {
          "enum": ["active", "expired", "revoked", "unauthorized", "superseded"]
        },
        "revokedAt": {"type": "string", "format": "date-time"},
        "revocationRef": {"type": "string", "minLength": 1}
      }
    },
    "capabilityRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "required"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "required": {"type": "boolean"}
      }
    },
    "preconditionClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["conditionId", "satisfied", "evidence"],
      "properties": {
        "conditionId": {"type": "string", "minLength": 1},
        "satisfied": {"type": "boolean"},
        "evidence": {"$ref": "#/$defs/evidence"}
      },
      "allOf": [
        {
          "if": {
            "properties": {"satisfied": {"const": true}},
            "required": ["satisfied"]
          },
          "then": {
            "properties": {"evidence": {"minItems": 1}}
          }
        }
      ]
    },
    "approvalReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approvalId",
        "stepId",
        "executionId",
        "decision",
        "approverId",
        "approverRole",
        "approvalPolicy",
        "approvalScopeKey",
        "decidedAt",
        "expiresAt",
        "boundRunbookVersionId",
        "boundRunbookContentDigest"
      ],
      "properties": {
        "approvalId": {"type": "string", "pattern": "^gra_[a-f0-9]{32}$"},
        "stepId": {"type": "string", "pattern": "^rbs_[a-f0-9]{32}$"},
        "executionId": {"type": "string", "minLength": 1},
        "decision": {"type": "string", "enum": ["approved", "denied"]},
        "approverId": {"type": "string", "minLength": 1},
        "approverRole": {"type": "string", "minLength": 1},
        "approvalPolicy": {"$ref": "#/$defs/approvalPolicySnapshot"},
        "approvalScopeKey": {"type": "string", "minLength": 1},
        "decidedAt": {"type": "string", "format": "date-time"},
        "expiresAt": {"type": "string", "format": "date-time"},
        "boundRunbookVersionId": {
          "type": "string",
          "pattern": "^rbv_[a-f0-9]{32}$"
        },
        "boundRunbookContentDigest": {"$ref": "#/$defs/digest"}
      }
    },
    "replayRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requestVersion",
        "executionId",
        "scope",
        "runbookVersionId",
        "runbookContentDigest",
        "operatorId",
        "requestedAt",
        "idempotencyKey",
        "capabilities",
        "preconditions",
        "approvals",
        "applicationObservations",
        "businessObjectInputs"
      ],
      "properties": {
        "requestVersion": {"type": "string", "const": "1"},
        "executionId": {"type": "string", "minLength": 1},
        "scope": {"$ref": "#/$defs/scope"},
        "runbookVersionId": {"type": "string", "pattern": "^rbv_[a-f0-9]{32}$"},
        "runbookContentDigest": {"$ref": "#/$defs/digest"},
        "operatorId": {"type": "string", "minLength": 1},
        "requestedAt": {"type": "string", "format": "date-time"},
        "idempotencyKey": {"type": "string", "minLength": 1},
        "targetStepId": {"type": "string", "pattern": "^rbs_[a-f0-9]{32}$"},
        "locatorResolution": {"$ref": "#/$defs/locatorResolution"},
        "capabilities": {
          "type": "array",
          "items": {"$ref": "#/$defs/providedCapability"},
          "uniqueItems": true
        },
        "preconditions": {
          "type": "array",
          "items": {"$ref": "#/$defs/preconditionClaim"}
        },
        "approvals": {
          "type": "array",
          "items": {"$ref": "#/$defs/approvalReceipt"}
        },
        "applicationObservations": {
          "type": "array",
          "items": {"$ref": "#/$defs/applicationObservation"}
        },
        "businessObjectInputs": {
          "type": "array",
          "items": {"$ref": "#/$defs/businessObjectInput"}
        }
      }
    },
    "precondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["conditionId", "description", "required", "evidence"],
      "properties": {
        "conditionId": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "required": {"type": "boolean"},
        "evidence": {"$ref": "#/$defs/evidence"}
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "policy"],
      "properties": {
        "required": {"type": "boolean"},
        "policy": {"type": "string", "enum": ["none", "perExecution", "perStep"]},
        "approverRole": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"required": {"const": true}}, "required": ["required"]},
          "then": {"required": ["approverRole"]},
          "else": {
            "properties": {"policy": {"const": "none"}},
            "not": {"required": ["approverRole"]}
          }
        }
      ]
    },
    "idempotency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "keyTemplate", "retryPolicy"],
      "properties": {
        "strategy": {
          "type": "string",
          "enum": ["notApplicable", "operatorConfirmation", "businessObjectKey", "externalKey"]
        },
        "keyTemplate": {"type": "string", "minLength": 1},
        "retryPolicy": {
          "type": "string",
          "enum": ["neverAfterAttempt", "retryReadOnlyWhenNotObserved"]
        }
      }
    },
    "completionProofRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "description"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["userConfirmation", "event", "objectState", "connectorReceipt"]
        },
        "description": {"type": "string", "minLength": 1}
      }
    },
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locatorId", "order", "kind", "value", "usage", "support", "evidence"],
      "properties": {
        "locatorId": {"type": "string", "pattern": "^rbl_[a-f0-9]{32}$"},
        "order": {"type": "integer", "minimum": 0},
        "kind": {
          "type": "string",
          "enum": ["accessibility", "dom", "url", "businessObject", "visual", "coordinate"]
        },
        "value": {"type": "string", "minLength": 1},
        "usage": {"type": "string", "enum": ["execution", "playbackOnly"]},
        "support": {"type": "string", "enum": ["supported", "unsupported"]},
        "evidence": {"$ref": "#/$defs/evidence"}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "coordinate"}}, "required": ["kind"]},
          "then": {
            "properties": {
              "usage": {"const": "playbackOnly"},
              "support": {"const": "unsupported"}
            }
          }
        }
      ]
    },
    "businessObjectSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["systemNamespace", "objectType", "role", "access", "anchorRequired"],
      "properties": {
        "systemNamespace": {"type": "string", "minLength": 1},
        "objectType": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1},
        "access": {"type": "string", "enum": ["read", "create", "update", "delete"]},
        "anchorRequired": {"type": "boolean"}
      }
    },
    "businessObjects": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inputs", "outputs"],
      "properties": {
        "inputs": {"type": "array", "items": {"$ref": "#/$defs/businessObjectSpec"}},
        "outputs": {"type": "array", "items": {"$ref": "#/$defs/businessObjectSpec"}}
      }
    },
    "branch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "branchId", "condition", "outcome", "evidence"],
      "properties": {
        "order": {"type": "integer", "minimum": 0},
        "branchId": {"type": "string", "minLength": 1},
        "condition": {"type": "string", "minLength": 1},
        "outcome": {"type": "string", "minLength": 1},
        "targetStepId": {"type": "string", "pattern": "^rbs_[a-f0-9]{32}$"},
        "evidence": {"$ref": "#/$defs/evidence"}
      }
    },
    "controlFlow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "branches"],
      "properties": {
        "mode": {"type": "string", "enum": ["unknown", "sequential", "decision", "terminal"]},
        "branches": {"type": "array", "items": {"$ref": "#/$defs/branch"}}
      }
    },
    "exceptionPath": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "pathId", "trigger", "action", "outcome", "evidence"],
      "properties": {
        "order": {"type": "integer", "minimum": 0},
        "pathId": {"type": "string", "minLength": 1},
        "trigger": {"type": "string", "minLength": 1},
        "action": {"type": "string", "minLength": 1},
        "outcome": {"type": "string", "enum": ["recovery", "escalation", "stop"]},
        "targetStepId": {"type": "string", "pattern": "^rbs_[a-f0-9]{32}$"},
        "evidence": {"$ref": "#/$defs/evidence"}
      }
    },
    "exceptionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "paths"],
      "properties": {
        "state": {"type": "string", "enum": ["unknown", "defined"]},
        "paths": {"type": "array", "items": {"$ref": "#/$defs/exceptionPath"}}
      }
    },
    "handoffContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "acceptanceConditions", "acceptanceProof"],
      "properties": {
        "mode": {"type": "string", "enum": ["unknown", "none", "transfer"]},
        "recipientRole": {"type": "string", "minLength": 1},
        "acceptanceConditions": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "acceptanceProof": {
          "type": "array",
          "items": {"$ref": "#/$defs/completionProofRequirement"}
        }
      }
    },
    "applicationConstraint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applicationId", "versionConstraint", "evidence"],
      "properties": {
        "applicationId": {"type": "string", "minLength": 1},
        "versionConstraint": {"type": "string", "minLength": 1},
        "environment": {"type": "string", "minLength": 1},
        "evidence": {"$ref": "#/$defs/evidence"}
      }
    },
    "applicationConstraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "constraints"],
      "properties": {
        "state": {"type": "string", "enum": ["unknown", "defined"]},
        "constraints": {"type": "array", "items": {"$ref": "#/$defs/applicationConstraint"}}
      }
    },
    "authorizedStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "variantRef",
        "stepId",
        "sequence",
        "signature",
        "instruction",
        "actorRole",
        "expectedOutcome",
        "sourceFactRefs",
        "evidence",
        "requiredCapabilities",
        "preconditions",
        "postconditions",
        "locators",
        "businessObjects",
        "controlFlow",
        "exceptionPolicy",
        "handoff",
        "applicationConstraints",
        "sideEffectClass",
        "approval",
        "idempotency",
        "completionProof",
        "gapRefs"
      ],
      "properties": {
        "variantRef": {"type": "string", "pattern": "^pmf_[a-f0-9]{32}$"},
        "stepId": {"type": "string", "pattern": "^rbs_[a-f0-9]{32}$"},
        "sequence": {"type": "integer", "minimum": 0},
        "signature": {"type": "string", "minLength": 1},
        "instruction": {"type": "string", "minLength": 1},
        "actorRole": {"type": "string", "minLength": 1},
        "expectedOutcome": {"type": "string", "minLength": 1},
        "sourceFactRefs": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "pattern": "^pmf_[a-f0-9]{32}$"},
          "uniqueItems": true
        },
        "evidence": {"$ref": "#/$defs/evidence"},
        "requiredCapabilities": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/capabilityRequirement"},
          "uniqueItems": true
        },
        "preconditions": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/precondition"}
        },
        "postconditions": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/precondition"}
        },
        "locators": {"type": "array", "items": {"$ref": "#/$defs/locator"}},
        "businessObjects": {"$ref": "#/$defs/businessObjects"},
        "controlFlow": {"$ref": "#/$defs/controlFlow"},
        "exceptionPolicy": {"$ref": "#/$defs/exceptionPolicy"},
        "handoff": {"$ref": "#/$defs/handoffContract"},
        "applicationConstraints": {"$ref": "#/$defs/applicationConstraints"},
        "sideEffectClass": {
          "type": "string",
          "enum": ["readOnly", "reversible", "irreversible", "unknown"]
        },
        "approval": {"$ref": "#/$defs/approval"},
        "idempotency": {"$ref": "#/$defs/idempotency"},
        "completionProof": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/completionProofRequirement"}
        },
        "gapRefs": {
          "type": "array",

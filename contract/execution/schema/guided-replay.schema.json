        "decisionContentDigest": {"$ref": "#/$defs/digest"},
        "runbook": {"$ref": "#/$defs/runbookRef"},
        "executionId": {"type": "string", "minLength": 1},
        "variantRef": {"type": "string", "pattern": "^pmf_[a-f0-9]{32}$"},
        "stepId": {"type": "string", "pattern": "^rbs_[a-f0-9]{32}$"},
        "logicalOperationKey": {"type": "string", "minLength": 1},
        "attemptNumber": {"type": "integer", "minimum": 1},
        "resolution": {
          "type": "string",
          "enum": ["cancelledBeforeStart", "reconciliationRequired", "unknown"]
        },
        "reason": {"type": "string", "minLength": 1},
        "resolvedBy": {"type": "string", "minLength": 1},
        "resolvedAt": {"type": "string", "format": "date-time"},
        "evidence": {"$ref": "#/$defs/evidence"},
        "authoritySnapshot": {"$ref": "#/$defs/reconciliationAuthority"},
        "supersedesReconciliationId": {
          "type": "string",
          "pattern": "^gerc_[a-f0-9]{32}$"
        },
        "trustedReconciliation": {"$ref": "#/$defs/trustedReconciliation"}
      },
      "allOf": [
        {
          "if": {
            "properties": {"resolution": {"const": "cancelledBeforeStart"}},
            "required": ["resolution"]
          },
          "then": {
            "not": {
              "anyOf": [
                {"required": ["startReceiptId"]},
                {"required": ["startReceiptContentDigest"]},
                {"required": ["trustedReconciliation"]},
                {"required": ["authoritySnapshot"]}
              ]
            }
          },
          "else": {
            "required": [
              "startReceiptId",
              "startReceiptContentDigest",
              "authoritySnapshot"
            ]
          }
        },
        {
          "if": {
            "properties": {"resolution": {"const": "unknown"}},
            "required": ["resolution"]
          },
          "then": {"required": ["trustedReconciliation"]}
        }
      ]
    },

        "claimId": {"type": "string", "pattern": "^gec_[a-f0-9]{32}$"},
        "claimContentDigest": {"$ref": "#/$defs/digest"},
        "startReceiptId": {"type": "string", "pattern": "^ges_[a-f0-9]{32}$"},
        "startReceiptContentDigest": {"$ref": "#/$defs/digest"},
        "recordedVia": {"type": "string", "enum": ["direct", "reconciliation"]},
        "receiptRequestId": {"type": "string", "minLength": 1},
        "executionId": {"type": "string", "minLength": 1},
        "decisionId": {"type": "string", "pattern": "^grd_[a-f0-9]{32}$"},
        "decisionContentDigest": {"$ref": "#/$defs/digest"},
        "requestDigest": {"$ref": "#/$defs/digest"},
        "runbook": {"$ref": "#/$defs/runbookRef"},
        "variantRef": {"type": "string", "pattern": "^pmf_[a-f0-9]{32}$"},
        "stepId": {"type": "string", "pattern": "^rbs_[a-f0-9]{32}$"},
        "operatorId": {"type": "string", "minLength": 1},
        "idempotencyKey": {"type": "string", "minLength": 1},
        "logicalOperationKey": {"type": "string", "minLength": 1},
        "idempotencyStrategy": {
          "enum": ["notApplicable", "operatorConfirmation", "businessObjectKey", "externalKey"]
        },
        "idempotencyKeyTemplate": {"type": "string", "minLength": 1},
        "retryPolicy": {
          "enum": ["neverAfterAttempt", "retryReadOnlyWhenNotObserved"]
        },

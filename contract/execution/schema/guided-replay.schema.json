        "evidence"
      ],
      "properties": {
        "artifactType": {"type": "string", "const": "executionReconciliation"},
        "schemaVersion": {"type": "string", "const": "1"},
        "reconciliationId": {"type": "string", "pattern": "^gerc_[a-f0-9]{32}$"},
        "contentDigest": {"$ref": "#/$defs/digest"},

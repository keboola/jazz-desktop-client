        "completedAt": {"type": "string", "format": "date-time"},
        "status": {"type": "string", "enum": ["succeeded", "partial", "failed", "aborted"]},
        "approvalsUsed": {
          "type": "array",
          "items": {"$ref": "#/$defs/approvalReceipt"},
          "uniqueItems": true
        },
        "executionContext": {"$ref": "#/$defs/executionContext"},
        "controlFlowRequirement": {"$ref": "#/$defs/controlFlow"},
        "branchDecision": {"$ref": "#/$defs/branchDecision"},
        "handoffRequirement": {"$ref": "#/$defs/handoffContract"},
        "handoffOutcome": {"$ref": "#/$defs/handoffOutcome"},
        "sideEffectClass": {
          "enum": ["readOnly", "reversible", "irreversible", "unknown"]
        },
        "sideEffects": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/sideEffectObservation"}
        },
        "interventions": {
          "type": "array",
          "items": {"$ref": "#/$defs/intervention"}
        },
        "result": {"$ref": "#/$defs/structuredResult"},
        "postconditionRequirements": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/precondition"}
        },
        "postconditions": {
          "type": "array",
          "items": {"$ref": "#/$defs/preconditionClaim"}
        },
        "completionProofRequirements": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/completionProofRequirement"}
        },
        "proofs": {
          "type": "array",
          "items": {"$ref": "#/$defs/completionProof"}
        },
        "trustedCompletion": {"$ref": "#/$defs/trustedCompletion"},
        "reconciliation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reconciledBy",
            "reconciledAt",
            "reason",
            "evidence",
            "authoritySnapshot"
          ],
          "properties": {
            "reconciledBy": {"type": "string", "minLength": 1},
            "reconciledAt": {"type": "string", "format": "date-time"},
            "reason": {"type": "string", "minLength": 1},
            "evidence": {"$ref": "#/$defs/evidence", "minItems": 1},
            "authoritySnapshot": {"$ref": "#/$defs/reconciliationAuthority"},
            "requiredReconciliationId": {
              "type": "string",
              "pattern": "^gerc_[a-f0-9]{32}$"
            }
          }
        },
        "exception": {"$ref": "#/$defs/executionException"}
      },
      "allOf": [
        {
          "if": {
            "properties": {"schemaVersion": {"const": "2"}},
            "required": ["schemaVersion"]
          },
          "then": {
            "required": [
              "claimId",
              "claimContentDigest",
              "startReceiptId",
              "startReceiptContentDigest",
              "recordedVia",
              "receiptRequestId"
            ]
          },
          "else": {
            "not": {
              "anyOf": [
                {"required": ["claimId"]},
                {"required": ["claimContentDigest"]},
                {"required": ["startReceiptId"]},
                {"required": ["startReceiptContentDigest"]},
                {"required": ["recordedVia"]},
                {"required": ["receiptRequestId"]},
                {"required": ["reconciliation"]}
              ]
            }
          }
        },
        {
          "if": {
            "properties": {"recordedVia": {"const": "reconciliation"}},
            "required": ["recordedVia"]
          },
          "then": {"required": ["reconciliation"]},
          "else": {"not": {"required": ["reconciliation"]}}
        },
        {
          "if": {
            "properties": {"status": {"const": "succeeded"}},
            "required": ["status"]
          },
          "then": {
            "properties": {"proofs": {"minItems": 1}}
          }
        },
        {
          "if": {
            "properties": {"status": {"enum": ["partial", "failed", "aborted"]}},
            "required": ["status"]
          },
          "then": {"required": ["exception"]}
        }
      ]
    }
  }

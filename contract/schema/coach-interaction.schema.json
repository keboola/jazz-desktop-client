{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jazz.dev/schema/coach-interaction.schema.json",
  "title": "JazzCaptureCoachInteraction",
  "description": "Canonical audit record for Capture Coach control data that was received, shown, suppressed, or acted on. It records user-visible behavior; it is not a semantic quality assessment.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "interactionId", "interactionType", "occurredAt"],
  "properties": {
    "schemaVersion": {"const": 1},
    "interactionId": {
      "type": "string",
      "pattern": "^coach-[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "interactionType": {
      "enum": ["received", "shown", "answered", "dismissed", "muted", "resumed", "finish_anyway", "suppressed", "unavailable"]
    },
    "occurredAt": {"type": "string", "format": "date-time"},
    "promptId": {
      "type": "string",
      "pattern": "^prompt-[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "labelId": {
      "$ref": "https://jazz.dev/archive/schema/archive-common.schema.json#/$defs/labelId"
    },
    "assessmentRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assessmentId", "revision", "inputDigest"],
      "properties": {
        "assessmentId": {
          "type": "string",
          "pattern": "^cqa-[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "revision": {"type": "integer", "minimum": 1},
        "inputDigest": {
          "$ref": "https://jazz.dev/archive/schema/archive-common.schema.json#/$defs/sha256"
        }
      }
    },
    "localBaselineRef": {
      "description": "Version-pinned deterministic local question plan. Its presence says only that a generic offline prompt was scheduled; it is not a semantic assessment of the captured evidence.",
      "type": "object",
      "additionalProperties": false,
      "required": ["planId", "planVersion", "planDigest"],
      "properties": {
        "planId": {"type": "string", "minLength": 1},
        "planVersion": {"type": "string", "minLength": 1},
        "planDigest": {
          "$ref": "https://jazz.dev/archive/schema/archive-common.schema.json#/$defs/sha256"
        }
      }
    },
    "inputWatermark": {
      "type": "object",
      "additionalProperties": false,
      "required": ["captureId", "streams"],
      "properties": {
        "schemaVersion": {"const": 2},
        "captureId": {
          "$ref": "https://jazz.dev/archive/schema/archive-common.schema.json#/$defs/captureId"
        },
        "streams": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["streamId", "throughSequence"],
            "properties": {
              "streamId": {
                "$ref": "https://jazz.dev/archive/schema/archive-common.schema.json#/$defs/streamId"
              },
              "throughSequence": {"type": "integer", "minimum": 0}
            }
          }
        },
        "captureCommitId": {
          "$ref": "https://jazz.dev/archive/schema/archive-common.schema.json#/$defs/commitId"
        },
        "captureCommit": {
          "type": "object",
          "additionalProperties": false,
          "required": ["captureCommitId", "contentDigest"],
          "properties": {
            "captureCommitId": {
              "$ref": "https://jazz.dev/archive/schema/archive-common.schema.json#/$defs/commitId"
            },
            "contentDigest": {
              "$ref": "https://jazz.dev/archive/schema/archive-common.schema.json#/$defs/sha256"
            }
          }
        },
        "transcripts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["transcriptId", "revision", "throughMillis", "textDigest", "finalized"],
            "properties": {
              "transcriptId": {
                "type": "string",
                "pattern": "^transcript-[A-Za-z0-9._:-]{1,200}$"
              },
              "revision": {"type": "integer", "minimum": 1},
              "throughMillis": {"type": "integer", "minimum": 0},
              "textDigest": {
                "$ref": "https://jazz.dev/archive/schema/archive-common.schema.json#/$defs/sha256"
              },
              "finalized": {"type": "boolean"},
              "contentDigest": {
                "$ref": "https://jazz.dev/archive/schema/archive-common.schema.json#/$defs/sha256"
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {"finalized": {"const": true}},
                  "required": ["finalized"]
                },
                "then": {"required": ["contentDigest"]},
                "else": {"not": {"required": ["contentDigest"]}}
              }
            ]
          }
        }
      },
      "allOf": [
        {
          "if": {"required": ["schemaVersion"]},
          "then": {
            "required": ["transcripts"],
            "not": {"required": ["captureCommitId"]}
          },
          "else": {
            "not": {
              "anyOf": [
                {"required": ["captureCommit"]},
                {"required": ["transcripts"]}
              ]
            }
          }
        }
      ]
    },
    "promptSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "slot", "policyVersion", "responseModes"],
      "properties": {
        "text": {"type": "string", "minLength": 1},
        "slot": {
          "enum": ["intent", "input_or_object", "decision_rule", "expected_output", "success", "exception", "handoff"]
        },
        "policyVersion": {"type": "string", "minLength": 1},
        "responseModes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["typed_text", "spoken"]}
        }
      }
    },
    "answer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": {"enum": ["typed_text", "spoken"]},
        "text": {"type": "string", "minLength": 1},
        "narrationArtifactId": {
          "$ref": "https://jazz.dev/archive/schema/archive-common.schema.json#/$defs/artifactId"
        }
      },
      "allOf": [
        {
          "if": {"properties": {"mode": {"const": "typed_text"}}, "required": ["mode"]},
          "then": {"required": ["text"], "not": {"required": ["narrationArtifactId"]}}
        },
        {
          "if": {"properties": {"mode": {"const": "spoken"}}, "required": ["mode"]},
          "then": {"required": ["narrationArtifactId"], "not": {"required": ["text"]}}
        }
      ]
    },
    "dispositionReason": {
      "enum": ["duplicate", "stale_watermark", "closed_label", "committed_capture", "interrupted_capture", "resolved_prompt", "offline", "coach_unavailable", "rate_limited", "user_action", "unsupported_version"]
    },
    "mutedUntil": {"type": "string", "format": "date-time"},
    "extensions": {"type": "object", "additionalProperties": true}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "interactionType": {"enum": ["received", "shown", "answered", "dismissed", "suppressed"]}
        },
        "required": ["interactionType"]
      },
      "then": {
        "required": ["promptId", "inputWatermark"],
        "oneOf": [
          {
            "required": ["assessmentRef"],
            "not": {"required": ["localBaselineRef"]}
          },
          {
            "required": ["localBaselineRef"],
            "not": {"required": ["assessmentRef"]}
          }
        ]
      }
    },
    {
      "if": {
        "properties": {"interactionType": {"enum": ["received", "shown"]}},
        "required": ["interactionType"]
      },
      "then": {"required": ["promptSnapshot"]}
    },
    {
      "if": {
        "properties": {"interactionType": {"const": "answered"}},
        "required": ["interactionType"]
      },
      "then": {"required": ["answer"]}
    },
    {
      "if": {
        "properties": {"interactionType": {"enum": ["suppressed", "unavailable"]}},
        "required": ["interactionType"]
      },
      "then": {"required": ["dispositionReason"]}
    }
  ]
}

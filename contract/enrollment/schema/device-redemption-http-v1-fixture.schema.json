{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jasnost.dev/enrollment/schema/device-redemption-http-v1-fixture.schema.json",
  "title": "JazzDeviceRedemptionHTTPV1Fixture",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fixtureVersion",
    "name",
    "testOnly",
    "bootstrap",
    "context",
    "pendingResponse",
    "readyResponse"
  ],
  "properties": {
    "fixtureVersion": { "const": 1 },
    "name": { "const": "native-device-redemption-http" },
    "testOnly": { "const": true },
    "bootstrap": {
      "$ref": "https://jasnost.dev/enrollment/schema/device-redemption-bootstrap-v1.schema.json"
    },
    "context": {
      "$ref": "https://jasnost.dev/enrollment/schema/device-redemption-context-v1.schema.json"
    },
    "pendingResponse": {
      "$ref": "https://jasnost.dev/enrollment/schema/device-redemption-status-v1.schema.json"
    },
    "readyResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statusCode",
        "contentType",
        "etag",
        "bundleSHA256",
        "bootstrapExpiresAt"
      ],
      "properties": {
        "statusCode": { "const": 200 },
        "contentType": {
          "const": "application/jazz-device-enrollment-sealed+json"
        },
        "etag": {
          "type": "string",
          "pattern": "^\"sha256:[a-f0-9]{64}\"$"
        },
        "bundleSHA256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "bootstrapExpiresAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        }
      }
    }
  }
}

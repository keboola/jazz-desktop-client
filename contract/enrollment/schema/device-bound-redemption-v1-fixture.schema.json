{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jazz.dev/enrollment/schema/device-bound-redemption-v1-fixture.schema.json",
  "title": "JazzDeviceBoundRedemptionV1GoldenFixture",
  "description": "Cross-language deterministic conformance vector. Every private key and bearer is test-only material and must never be used as production authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fixtureVersion",
    "name",
    "testOnly",
    "bootstrap",
    "claimPayload",
    "claimEnvelope",
    "signedDeviceBundle",
    "sealedBundle",
    "expected"
  ],
  "properties": {
    "fixtureVersion": {
      "const": 1
    },
    "name": {
      "const": "p256-device-bound-redemption"
    },
    "testOnly": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proofPrivateKey",
        "wrappingPrivateKey",
        "ephemeralPrivateKey",
        "salt",
        "iv"
      ],
      "properties": {
        "proofPrivateKey": {
          "$ref": "#/$defs/privateScalar"
        },
        "wrappingPrivateKey": {
          "$ref": "#/$defs/privateScalar"
        },
        "ephemeralPrivateKey": {
          "$ref": "#/$defs/privateScalar"
        },
        "salt": {
          "$ref": "#/$defs/base64url32"
        },
        "iv": {
          "type": "string",
          "minLength": 16,
          "maxLength": 16,
          "pattern": "^[A-Za-z0-9_-]+$"
        }
      }
    },
    "bootstrap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bootstrapId",
        "deviceId",
        "bearerSha256",
        "issuedAt",
        "expiresAt"
      ],
      "properties": {
        "bootstrapId": {
          "type": "string",
          "pattern": "^jbt_[a-f0-9]{32}$"
        },
        "deviceId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        "bearerSha256": {
          "$ref": "#/$defs/sha256"
        },
        "issuedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "expiresAt": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "claimPayload": {
      "$ref": "https://jazz.dev/enrollment/schema/device-claim-v1-payload.schema.json"
    },
    "claimEnvelope": {
      "$ref": "https://jazz.dev/enrollment/schema/device-claim-v1-envelope.schema.json"
    },
    "signedDeviceBundle": {
      "type": "string",
      "minLength": 1,
      "maxLength": 174763,
      "pattern": "^[A-Za-z0-9_-]+$",
      "description": "Unpadded base64url of the exact flattened signed-device-bundle JSON bytes used as plaintext."
    },
    "sealedBundle": {
      "$ref": "https://jazz.dev/enrollment/schema/sealed-device-bundle-v1-envelope.schema.json"
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claimSha256",
        "proofKeyThumbprint",
        "wrappingKeyThumbprint",
        "bundleSha256",
        "sealedBundleSha256"
      ],
      "properties": {
        "claimSha256": {
          "$ref": "#/$defs/sha256"
        },
        "proofKeyThumbprint": {
          "$ref": "#/$defs/base64url32"
        },
        "wrappingKeyThumbprint": {
          "$ref": "#/$defs/base64url32"
        },
        "bundleSha256": {
          "$ref": "#/$defs/sha256"
        },
        "sealedBundleSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  },
  "$defs": {
    "base64url32": {
      "type": "string",
      "minLength": 43,
      "maxLength": 43,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "privateScalar": {
      "$ref": "#/$defs/base64url32",
      "description": "Test-only canonical 32-byte P-256 private scalar."
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}

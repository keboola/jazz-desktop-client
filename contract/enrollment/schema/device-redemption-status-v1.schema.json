{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jasnost.dev/enrollment/schema/device-redemption-status-v1.schema.json",
  "title": "JazzDeviceRedemptionStatusV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "bootstrapId",
    "deviceId",
    "bundleId",
    "generation",
    "state",
    "serverTime",
    "expiresAt"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "jazz-device-redemption-status" },
    "bootstrapId": { "type": "string", "pattern": "^jbt_[a-f0-9]{32}$" },
    "deviceId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "bundleId": { "type": "string", "pattern": "^jdb_[a-f0-9]{32}$" },
    "generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "state": {
      "type": "string",
      "enum": ["pending", "expired", "quarantined"]
    },
    "claimId": { "type": "string", "pattern": "^jcl_[a-f0-9]{32}$" },
    "disposition": {
      "type": "string",
      "enum": ["bound", "exact_retry"]
    },
    "quarantineCode": { "type": "string", "minLength": 1, "maxLength": 128 },
    "serverTime": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jazz.dev/schema/windows-client-policy.schema.json",
  "title": "Jazz Windows client policy",
  "type": "object",
  "additionalProperties": true,
  "required": ["kind", "schema", "pauseReminderMinutes"],
  "properties": {
    "kind": {
      "const": "jazz-windows-client-policy"
    },
    "schema": {
      "type": "integer",
      "const": 1
    },
    "pauseReminderMinutes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1440
    },
    "voiceConsentEpoch": {
      "type": "integer",
      "minimum": 0
    },
    "recording_mode": {
      "type": "string",
      "enum": ["continuous", "session"]
    },
    "recordingMode": {
      "type": "string",
      "enum": ["continuous", "session"]
    }
  }
}

<?xml version="1.0" encoding="utf-8"?>
<!--
  The per-user MSI for the Jazz Windows capture client, in WiX v6 authoring, built on Windows.

  Everything variable comes in from Jazz.Installer.wixproj, which reads Jazz.Version.props, so the
  cross-platform `wixl` sibling in wixl/product.wxs describes the same product rather than a
  lookalike. Only the schema differs between the two files; every identity, path and registry value
  is passed in from the same source.

  Two properties of this package matter more than the rest and are asserted by Verify-Msi.ps1
  against the finished database, because authoring that compiles is not authoring that installs
  correctly:

    1. It is per-user. Scope="perUser" means no ALLUSERS, no elevation prompt, and a payload that
       lands in the user's own profile. A capture client that demands an administrator to install
       is a capture client that never gets installed.

    2. Uninstall does not touch captured data. The client keeps recordings, queued archives and
       settings in %LOCALAPPDATA%\Jazz; the payload goes one level down in %LOCALAPPDATA%\Jazz\App.
       The RemoveFolder below names the App directory and nothing above it, so removing the product
       removes the product. Deleting a user's unexported recordings on uninstall would be the worst
       bug this repository could ship, so the separation is structural rather than a promise.

  A third property matters just as much (#60 slice 2): the package writes exactly one deployable
  preference, JAZZ_CAPTURE_AT_LAUNCH, under HKCU only, with zero custom actions.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <Package Name="$(var.ProductName)"
           Manufacturer="$(var.Manufacturer)"
           Version="$(var.ProductVersion)"
           UpgradeCode="$(var.UpgradeCode)"
           ProductCode="$(var.ProductCode)"
           Language="1033"
           Codepage="1252"
           Scope="perUser"
           Compressed="yes">

    <SummaryInformation Description="$(var.ProductName) $(var.ProductVersion) (per-user install)"
                        Manufacturer="$(var.Manufacturer)" />

    <!-- The upgrade rule. A newer build removes the installed one instead of joining it; an older
         one refuses rather than silently downgrading a client whose journal format may have moved
         on. Same-version reinstall needs no rule here: the ProductCode is derived from the version,
         so Windows Installer already recognises it as the same product and repairs it. -->
    <MajorUpgrade Schedule="afterInstallInitialize"
                  DowngradeErrorMessage="A newer version of $(var.ProductName) is already installed. Uninstall it first if you really need to go back." />

<?if $(var.TestOnlyBuild) = "true" ?>
    <Property Id="JAZZ_TEST_ONLY_PAYLOAD_VARIANT" Value="$(var.TestPayloadVariant)" />
<?endif?>
<?if $(var.TestOnlyFailure) = "true" ?>
    <!-- Compiled only by Jazz.UpgradeTests.wixproj. The production project defines this false and
         Verify-Msi.ps1 hard-fails if the action or marker reaches a release database. -->
    <Property Id="JAZZ_TEST_ONLY_ROLLBACK_FIXTURE" Value="1" />
    <CustomAction Id="FailAfterRemoveExisting"
                  Error="Deliberate test-only failure after removal of the previous test product." />
    <InstallExecuteSequence>
      <Custom Action="FailAfterRemoveExisting"
              After="RemoveExistingProducts"
              Condition="WIX_UPGRADE_DETECTED" />
    </InstallExecuteSequence>
<?endif?>

    <MediaTemplate EmbedCab="yes" />

    <!-- %LOCALAPPDATA%\Jazz is the client's data root and predates any install: it holds captures\,
         queue\ and the settings document. The installer declares it only so it can nest the payload
         underneath, and never writes a file into it. -->
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="JazzDataFolder" Name="$(var.DataFolderName)" ComponentGuidGenerationSeed="$(var.ComponentGuidSeed)">
        <Directory Id="INSTALLFOLDER" Name="$(var.InstallFolderName)" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ShortcutFolder" Name="$(var.StartMenuFolderName)" />
    </StandardDirectory>

    <!-- The self-contained win-x64 publish output, harvested whole - including the two symbol
         files the client's own assemblies produce. They cost almost nothing next to the bundled
         runtime, and they are the difference between a stack trace with line numbers and one
         without on a machine nobody can attach a debugger to. -->
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.PublishDir)\**" />
    </ComponentGroup>

    <Component Id="AutoStart" Directory="INSTALLFOLDER" Guid="$(var.AutoStartComponentGuid)">
      <!-- Start at login, the per-user way. This is what the macOS client's login item is; a
           service would need elevation to install and would run outside the user's session, where
           a tray client that captures that session's desktop cannot do its job. -->
      <RegistryValue Root="HKCU"
                     Key="$(var.RunKey)"
                     Name="$(var.RunValueName)"
                     Type="string"
                     Value="&quot;[INSTALLFOLDER]$(var.ExecutableName)&quot;"
                     KeyPath="yes" />

      <!-- Removes %LOCALAPPDATA%\Jazz\App once its files are gone. Note what is absent: no
           RemoveFolder for JazzDataFolder, so %LOCALAPPDATA%\Jazz survives uninstall with the
           user's recordings, queued archives and settings in it. -->
      <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
    </Component>

    <Component Id="StartMenuShortcut" Directory="ShortcutFolder" Guid="$(var.ShortcutComponentGuid)">
      <!-- A user who quits the tray host before the next logon needs a way back that is not
           browsing to a hidden directory. -->
      <Shortcut Id="JazzCaptureShortcut"
                Name="$(var.ShortcutName)"
                Description="Start a consent-based Jazz desktop capture session"
                Target="[INSTALLFOLDER]$(var.ExecutableName)"
                WorkingDirectory="INSTALLFOLDER" />
      <RemoveFolder Id="RemoveShortcutFolder" Directory="ShortcutFolder" On="uninstall" />
      <!-- An HKCU key path rather than the shortcut file, which is both what ICE43 asks of a
           non-advertised shortcut and what lets a repair recreate a shortcut a user deleted. -->
      <RegistryValue Root="HKCU"
                     Key="Software\$(var.Manufacturer)\$(var.DataFolderName)"
                     Name="StartMenuShortcut"
                     Type="integer"
                     Value="1"
                     KeyPath="yes" />
    </Component>

    <!--
      The deployable installer preference (#60 slice 2). This is a deliberately reduced form of the
      Windows Installer "remember a property" pattern: a public property with a default, a
      RegistrySearch that reloads whatever was deployed, and one component that writes the property
      back - but without the pattern's usual SaveCmdLineValue/SetFromCmdLineValue type-51 custom
      actions, which exist solely to stop AppSearch overwriting a value supplied on the msiexec
      command line (see the paragraph below). Zero custom actions - the CustomAction table stays
      empty and Verify-Msi.ps1 asserts that.

      There is deliberately no Condition anywhere. A <Condition> child element aborts `wixl`
      outright (issue #60, PR #86 probe), which would break the cross-build authoring parity that
      wixl/product.wxs exists to guarantee. None is needed, because under #60 amendment 3 a written
      "0" means "no opinion" and falls through to the user's own setting - so the unconditional
      default write is behaviourally identical to writing nothing.

      What that costs, knowingly: nothing validates the value at install time. `msiexec …
      JAZZ_CAPTURE_AT_LAUNCH=maybe` succeeds and writes `maybe`. The client then reads it as
      Malformed and enforces capture off with a visible reason, so it never falls through to the
      permissive setting - but the install itself reports success. docs/INTUNE_DEPLOYMENT.md says so
      in plain words.

      AppSearch overwrites the property with whatever RegistrySearch finds - including a value
      supplied on the msiexec command line - so this is a first-install deployment input, not a
      channel for changing an already-deployed preference (issue #60 slice 2 plan, section 0).

      A narrower, confirmed edge case (Copilot review, this PR): the RegistryValue below writes the
      *formatted* property value, and Windows Installer decides the registry type from that
      formatted text's leading characters - not from Type="string" alone, which only controls what
      WiX itself writes when the authored Value is a literal. This is by design for the ordinary
      case: it is exactly how an *existing* REG_DWORD value (say, one Intune's settings catalog
      wrote directly) survives a repair or upgrade unchanged - RememberCaptureAtLaunch's raw
      RegistrySearch reconstructs the '#' marker from the value it finds, and the write below
      reconstructs REG_DWORD from that same marker. Empirically verified with a throwaway probe
      package, seeding REG_DWORD 1 before install and finding it still REG_DWORD 1 afterward. The
      same mechanism cannot tell that apart from a value handed to it directly on the msiexec
      command line: JAZZ_CAPTURE_AT_LAUNCH=#1 also writes REG_DWORD 1, not REG_SZ "#1" - confirmed
      the same way. For "#0" and "#1"
      specifically, that DWORD ends up parsing as Disabled/Enabled instead of the Malformed result a
      literal "#0"/"#1" would otherwise get, which is a narrow instance of the same "no install-time
      validation" gap above, not a new one - every other malformed string (including any other
      "#N") still reads as Malformed either way, since NormalizeRegistryValue's int/string handling
      agrees on any value that isn't exactly "0" or "1". There is no fix for this within the
      "zero custom actions, no Condition element, wixl parity" constraints (the same limits that
      already rule out install-time validation above), and it crosses no privilege boundary this
      package doesn't already have: HKCU is writable by the same user either way, with or without
      this MSI. docs/INTUNE_DEPLOYMENT.md documents it.
    -->
    <Property Id="$(var.PolicyPropertyName)" Value="0" Secure="yes">
      <RegistrySearch Id="RememberCaptureAtLaunch"
                      Root="HKCU"
                      Key="Software\$(var.Manufacturer)\$(var.DataFolderName)\Policy"
                      Name="$(var.PolicyValueName)"
                      Type="raw" />
    </Property>

    <Component Id="CaptureAtLaunchPolicy" Directory="INSTALLFOLDER" Guid="$(var.PolicyComponentGuid)">
      <!-- Type="string" is load-bearing, not a default. CaptureAtLaunchPolicyStore checks the
           registry *kind* before it reads the value (CaptureAtLaunchPolicyStore.cs:242-286) and
           accepts only REG_DWORD and REG_SZ. An "expandable" type here would make every installed
           machine read Malformed and sit enforced-off. -->
      <RegistryValue Root="HKCU"
                     Key="Software\$(var.Manufacturer)\$(var.DataFolderName)\Policy"
                     Name="$(var.PolicyValueName)"
                     Type="string"
                     Value="[$(var.PolicyPropertyName)]"
                     KeyPath="yes" />
    </Component>

    <Icon Id="JazzCapture.ico" SourceFile="$(var.IconSource)" />
    <Property Id="ARPPRODUCTICON" Value="JazzCapture.ico" />
    <!-- There is nothing to reconfigure from Add/Remove Programs: the settings live in the tray
         host's own window, and a Modify entry that opens an empty feature tree is a dead end. -->
    <Property Id="ARPNOMODIFY" Value="1" />

    <Feature Id="Main" Title="$(var.ProductName)" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="AutoStart" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="CaptureAtLaunchPolicy" />
    </Feature>

  </Package>

</Wix>

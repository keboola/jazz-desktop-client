<?xml version="1.0" encoding="utf-8"?>
<!--
  The same per-user MSI as ../Package.wxs, in the WiX v3 schema that GNU msitools' `wixl` reads, so
  the installer can be built and inspected on the macOS and Linux machines this client is developed
  on. ../build-msi.ps1 is the path that produces the shipped package; ../build-msi.sh produces this
  one.

  Why a second file rather than a shared one: the WiX v4+ toolchain builds MSIs only on Windows, and
  `wixl` implements the v3 schema only. There is no schema both accept.

  Two authorings of one product is exactly the kind of arrangement that drifts, so the drift is
  policed rather than promised:

    * every identity, path and registry value in both files is substituted in from
      ../Jazz.Version.props, so neither file can name a version, GUID, directory or Run value the
      other does not;
    * ../verify-msi.sh asserts the same claims against this package that ../Verify-Msi.ps1 asserts
      against the Windows-built one, and both run in CI. If `wixl` ever stops producing an
      equivalent database, a job fails rather than a user discovering it.

  Two differences remain and are not worth hiding. `wixl` runs no ICE validation, and it ignores
  attributes it does not implement with only a warning on stderr - including RemoveFolder/@Directory,
  which it infers from the enclosing DirectoryRef instead. The authoring below therefore never
  relies on a RemoveFolder targeting anything other than the directory it sits in.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">

  <Product Id="$(var.ProductCode)"
           Name="$(var.ProductName)"
           Language="1033"
           Codepage="1252"
           Version="$(var.ProductVersion)"
           Manufacturer="$(var.Manufacturer)"
           UpgradeCode="$(var.UpgradeCode)">

    <!-- InstallScope="perUser" is what makes this a per-user package under wixl: it leaves ALLUSERS
         unset and sets the summary word-count bit that tells Windows Installer no elevation is
         required. Verified, not assumed - verify-msi.sh asserts both. -->
    <Package InstallerVersion="500"
             Compressed="yes"
             InstallScope="perUser"
             Description="$(var.ProductName) $(var.ProductVersion) (per-user install)"
             Manufacturer="$(var.Manufacturer)" />

    <!-- wixl 0.106 does not implement MajorUpgrade/@Schedule. Keep MajorUpgrade for the Upgrade
         table and author the standard action position explicitly below. -->
    <MajorUpgrade DowngradeErrorMessage="A newer version of $(var.ProductName) is already installed. Uninstall it first if you really need to go back." />
    <InstallExecuteSequence>
      <RemoveExistingProducts After="InstallInitialize" />
    </InstallExecuteSequence>
    <Media Id="1" Cabinet="jazz.cab" EmbedCab="yes" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="LocalAppDataFolder">
        <!-- The client's data root: captures\, queue\ and the settings document already live here.
             Declared so the payload can nest underneath, never written into, never removed. -->
        <Directory Id="JazzDataFolder" Name="$(var.DataFolderName)">
          <Directory Id="INSTALLFOLDER" Name="$(var.InstallFolderName)" />
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ShortcutFolder" Name="$(var.StartMenuFolderName)" />
      </Directory>
    </Directory>

    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="AutoStart" Guid="$(var.AutoStartComponentGuid)">
        <!-- Start at login, the per-user way: no service, no elevation, no scheduled task. -->
        <RegistryValue Root="HKCU"
                       Key="$(var.RunKey)"
                       Name="$(var.RunValueName)"
                       Type="string"
                       Value="&quot;[INSTALLFOLDER]$(var.ExecutableName)&quot;"
                       KeyPath="yes" />
        <!-- Removes %LOCALAPPDATA%\Jazz\App and deliberately nothing above it. -->
        <RemoveFolder Id="RemoveInstallFolder" On="uninstall" />
      </Component>

      <!-- Probe, third of three: a component Condition. #60 slice 2 needs an absent
           property to write nothing at all, and the property's own value to be what
           lands in the registry. MUST NOT MERGE. -->
      <Component Id="ProbeCaptureAtLaunchPolicy" Guid="6F1B2C34-9A7D-4E58-B0C1-7D2E4F6A8B90">
        <Condition><![CDATA[JAZZ_CAPTURE_AT_LAUNCH]]></Condition>
        <RegistryValue Root="HKCU"
                       Key="Software\Keboola\JazzWixlProbe"
                       Name="CaptureAtLaunch"
                       Type="string"
                       Value="[JAZZ_CAPTURE_AT_LAUNCH]"
                       KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="ShortcutFolder">
      <Component Id="StartMenuShortcut" Guid="$(var.ShortcutComponentGuid)">
        <Shortcut Id="JazzCaptureShortcut"
                  Name="$(var.ShortcutName)"
                  Description="Start a consent-based Jazz desktop capture session"
                  Target="[INSTALLFOLDER]$(var.ExecutableName)"
                  WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="RemoveShortcutFolder" On="uninstall" />
        <RegistryValue Root="HKCU"
                       Key="Software\$(var.Manufacturer)\$(var.DataFolderName)"
                       Name="StartMenuShortcut"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <Icon Id="JazzCapture.ico" SourceFile="$(var.IconSource)" />
    <Property Id="ARPPRODUCTICON" Value="JazzCapture.ico" />
    <Property Id="ARPNOMODIFY" Value="1" />

    <!-- ############################################################################
         THROWAWAY CAPABILITY PROBE FOR #60 SLICE 2. MUST NOT MERGE.

         #60 slice 2 needs three things from this authoring that nothing in this file
         uses today: a RegistrySearch (to remember a deployed property across repair
         and upgrade), a LaunchCondition (to reject an invalid value without a custom
         action), and a component Condition (so an absent property writes nothing).

         This file's own header warns that wixl "ignores attributes it does not
         implement with only a warning on stderr". If it drops any of the three, the
         two authorings stop describing the same product -- and the failure mode that
         matters is not a red job, it is a GREEN one over a package quietly missing
         these rows. So the probe does not assert anything: verify-msi.sh dumps the
         RegLocator, AppSearch and LaunchCondition tables, and the CI log answers the
         question directly.

         Deliberately self-contained: a literal key, no new Jazz.Version.props
         variables, no Package.wxs counterpart. The Windows-side WiX v4 behaviour is
         not in doubt; only wixl's is.
         ############################################################################ -->
    <Property Id="JAZZ_CAPTURE_AT_LAUNCH" Secure="yes">
      <RegistrySearch Id="ProbeRememberCaptureAtLaunch"
                      Root="HKCU"
                      Key="Software\Keboola\JazzWixlProbe"
                      Name="CaptureAtLaunch"
                      Type="raw" />
    </Property>

    <Condition Message="JAZZ_CAPTURE_AT_LAUNCH must be 0 or 1.">
      <![CDATA[NOT JAZZ_CAPTURE_AT_LAUNCH OR JAZZ_CAPTURE_AT_LAUNCH = "0" OR JAZZ_CAPTURE_AT_LAUNCH = "1"]]>
    </Condition>

    <Feature Id="Main" Title="$(var.ProductName)" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="AutoStart" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="ProbeCaptureAtLaunchPolicy" />
    </Feature>

  </Product>

</Wix>

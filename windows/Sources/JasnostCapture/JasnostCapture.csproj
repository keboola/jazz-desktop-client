<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>JasnostCapture</RootNamespace>
    <AssemblyName>JasnostCapture</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Lets the WPF/WinForms desktop targets restore and compile on macOS/Linux; the app only
         actually runs on Windows 11 (verified live in Task 10). -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- Win32 struct marshalling for the low-level hooks and UI Automation interop. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\JasnostCaptureCore\JasnostCaptureCore.csproj" />
  </ItemGroup>

</Project>

<Window x:Class="JazzCapture.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Jazz Capture settings"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <StackPanel Margin="16">
        <TextBlock x:Name="NoticeText"
                   Margin="0,0,0,12"
                   Padding="8"
                   Background="#FFF4E5"
                   TextWrapping="Wrap"
                   Visibility="Collapsed"
                   Text="" />

        <CheckBox x:Name="HighlightClicksBox"
                  Content="Highlight where I click on screen" />

        <CheckBox x:Name="VoiceRecordingBox"
                  Margin="0,8,0,0"
                  Content="Allow voice recording during the labeled task" />

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button x:Name="CloseButton"
                    Content="Close"
                    Width="110"
                    Margin="0,0,8,0"
                    IsCancel="True"
                    Click="OnClose" />
            <Button x:Name="SaveButton"
                    Content="Save"
                    Width="110"
                    IsDefault="True"
                    Click="OnSave" />
        </StackPanel>
    </StackPanel>
</Window>

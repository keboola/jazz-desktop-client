<Window x:Class="JazzCapture.PauseReminderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Jazz Capture"
        Width="380"
        SizeToContent="Height"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize">
    <StackPanel Margin="16">
        <TextBlock FontSize="14"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap"
                   Text="Jazz Capture is still paused" />
        <TextBlock Margin="0,8,0,0"
                   TextWrapping="Wrap"
                   Foreground="#555"
                   Text="If that is intentional, you can ignore this. Resume capture when you want recording to continue." />
        <Button Content="OK"
                Width="90"
                HorizontalAlignment="Right"
                Margin="0,16,0,0"
                IsDefault="True"
                Click="OnOk" />
    </StackPanel>
</Window>

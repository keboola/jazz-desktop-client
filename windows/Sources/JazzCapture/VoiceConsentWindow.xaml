<Window x:Class="JazzCapture.VoiceConsentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Jazz Capture"
        Width="500"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize">
    <StackPanel Margin="16">
        <TextBlock FontSize="14"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap"
                   Text="Would you like to describe what you are doing?" />
        <TextBlock Margin="0,8,0,0"
                   TextWrapping="Wrap"
                   Foreground="#555"
                   Text="Jazz will record your microphone until you end this label. Windows will not list Jazz next to Store apps (Copilot, Sound Recorder). Desktop programs share one switch: Privacy → Microphone → Let desktop apps access your microphone. That switch is already On, so Jazz can record without appearing in that Store-app list. You can change this later in Jazz Settings." />
        <CheckBox x:Name="DontAskAgainBox"
                  Margin="0,16,0,0"
                  Content="Don't ask again" />
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="Not now"
                    Width="110"
                    Margin="0,0,8,0"
                    IsCancel="True"
                    Click="OnNotNow" />
            <Button Content="Yes"
                    Width="110"
                    IsDefault="True"
                    Click="OnYes" />
        </StackPanel>
    </StackPanel>
</Window>

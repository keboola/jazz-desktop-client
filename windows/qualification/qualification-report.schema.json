{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jazz.dev/schema/windows-qualification-report-v1.json",
  "title": "Jazz Windows qualification report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "status",
    "generatedAt",
    "durationMilliseconds",
    "source",
    "package",
    "environment",
    "checks",
    "limitations"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "kind": { "enum": ["automated-msi-lifecycle", "automated-msi-upgrade-matrix", "manual-real-windows", "helper-test"] },
    "status": { "enum": ["passed", "failed", "blocked", "incomplete"] },
    "generatedAt": { "type": "string", "format": "date-time" },
    "durationMilliseconds": { "type": "integer", "minimum": 0 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "runId", "runAttempt"],
      "properties": {
        "commit": { "type": "string" },
        "runId": { "type": ["string", "null"] },
        "runAttempt": { "type": ["string", "null"] }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "productName",
        "productVersion",
        "productCode",
        "packageCode",
        "upgradeCode",
        "byteLength",
        "sha256",
        "signerStatus"
      ],
      "properties": {
        "productName": { "enum": ["Jazz Capture", "Jazz Capture Upgrade Fixture"] },
        "productVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "productCode": { "type": "string" },
        "packageCode": { "type": "string" },
        "upgradeCode": { "type": "string" },
        "byteLength": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "signerStatus": { "type": "string" }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "osVersion",
        "architecture",
        "processArchitecture",
        "privilege",
        "userInteractive",
        "sessionId"
      ],
      "properties": {
        "osVersion": { "type": "string" },
        "architecture": { "type": "string" },
        "processArchitecture": { "type": "string" },
        "privilege": { "enum": ["standard-user", "administrator"] },
        "userInteractive": { "type": "boolean" },
        "sessionId": { "type": "integer", "minimum": 0 }
      }
    },
    "run": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["runId", "profileRole", "relatedPrimaryRunId", "phase"],
      "properties": {
        "runId": { "type": "string", "format": "uuid" },
        "profileRole": { "enum": ["primary", "secondary"] },
        "relatedPrimaryRunId": { "type": ["string", "null"], "format": "uuid" },
        "phase": { "enum": ["installed", "observed", "completed"] }
      }
    },
    "failurePhase": { "type": ["string", "null"] },
    "inventory": { "type": ["object", "null"] },
    "sentinels": { "type": ["object", "null"] },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "detail"],
        "properties": {
          "id": { "type": "string" },
          "status": { "enum": ["passed", "failed", "blocked", "not-run", "observed"] },
          "detail": { "type": "string" }
        }
      }
    },
    "limitations": { "type": "array", "items": { "type": "string" } }
  }
}
